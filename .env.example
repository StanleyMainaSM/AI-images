# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# GEMINI_IMAGE_MODEL: Configurable image generation model.
# Supported defaults: "gemini-3.1-flash-lite-image" (recommended default), "gemini-3.1-flash-image", or "imagen-3.0-generate-002".
GEMINI_IMAGE_MODEL=""

# AI_IMAGE_PROVIDER: Active image provider implementation.
AI_IMAGE_PROVIDER="gemini"

# APP_URL: The URL where this applet is hosted.
APP_URL=""

