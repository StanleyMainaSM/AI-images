# Google Gemini API key. Keep this on the server/secret manager; never put it in frontend code.
GEMINI_API_KEY=""

# Current Google image model. Image generation is not included in Gemini's Free API tier.
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# Active provider.
AI_IMAGE_PROVIDER="gemini"

# Optional application URL.
APP_URL=""
